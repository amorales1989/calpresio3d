# Copiá este archivo a .env para correr el servidor en tu compu. En Coolify van como variables de entorno.

# Base de datos (en Coolify: la "Postgres URL (internal)" del recurso PostgreSQL)
DATABASE_URL=postgres://postgres:test@localhost:55432/calc3d

# Tu usuario y contraseña para entrar a la app (contraseña de 10+ caracteres)
ADMIN_USER=ale
ADMIN_PASSWORD=cambiame-por-una-larga

# Duración de la sesión en días (no te pide login de nuevo hasta entonces)
SESSION_DAYS=90

# Solo para probar en http://localhost: en producción la cookie es solo HTTPS
COOKIE_SECURE=false

# Mails del aviso de "terminado" (opcional: sin esto los avisos quedan simulados).
# Ej. Gmail: smtp.gmail.com, 465, tu cuenta y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Impresiones 3D <tu-cuenta@gmail.com>"
